# Docker Compose: copy to .env and fill in these values.
# Domain only: no scheme, port, slash, or path.
SITE_DOMAIN=
OPERATOR_NAME=
CONTACT_EMAIL=
COPYRIGHT_EMAIL=
# Describe your hosting provider/location and any provider logs/retention.
HOSTING_DESCRIPTION=
# Comma-separated Instagram post shortcodes blocked after review:
BLOCKED_SHORTCODES=

# For local npm start, leave the above empty. Optional executable paths:
# PYTHON=/absolute/path/to/python
# FFMPEG_PATH=/absolute/path/to/ffmpeg
# PORT=4178

# For hosting without Compose (see DEPLOY.md):
# NODE_ENV=production
# BIND_HOST=127.0.0.1
# PUBLIC_ORIGIN=https://your-domain.example
# TRUST_PROXY=1
